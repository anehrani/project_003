{
  "name": "@budgetguard/worker",
  "version": "0.1.0",
  "private": true,
  "description": "BudgetGuard worker — runs the engine every 15 minutes and executes actions against Meta.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "check-once": "tsx src/run-once.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@budgetguard/db": "*",
    "@budgetguard/engine": "*",
    "@budgetguard/meta": "*",
    "dotenv": "^16.4.7",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
