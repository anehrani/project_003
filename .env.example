# ---- Database (PostgreSQL — Railway/Supabase/Neon all work) ----
# Local dev/test DB via Docker:  npm run db:up
DATABASE_URL=postgresql://user:password@host:5432/budgetguard
# Local Docker default:
# DATABASE_URL=postgresql://budgetguard:budgetguard@localhost:5432/budgetguard

# ---- Security ----
# 32-byte hex key used to encrypt Google OAuth tokens at rest (AES-256-GCM).
# Generate: openssl rand -hex 32
APP_ENCRYPTION_KEY=replace-with-64-char-hex
# Shared secret for POST /internal/worker/check-all
WORKER_SECRET=replace-with-random-string

# ---- Google Cloud project (console.cloud.google.com) ----
# 1. Create/select a project → Enable the "Google Ads API"
# 2. OAuth consent screen (External, add yourself as test user)
# 3. Credentials → OAuth 2.0 Client ID (Web application) → copy id + secret
# 4. Get a refresh token with scope https://www.googleapis.com/auth/adwords
#    (e.g. https://developers.google.com/oauthplayground using your own client)
GOOGLE_ADS_CLIENT_ID=replace-with-apps.googleusercontent.com-client-id
GOOGLE_ADS_CLIENT_SECRET=replace-with-client-secret
# Legacy header — optional since the Sept 2026 access-model change; set only if
# your project still uses a developer token.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v26

# ---- Dev seeding (scripts/seed-dev.ts — optional, used by `npm run db:seed`) ----
# Tier 2/3 testing: a real refresh token for a Google Ads TEST account (fake money).
# Leave unset for Tier-1 testing with a dummy token.
DEV_REFRESH_TOKEN=
DEV_CUSTOMER_ID=
DEV_CAMPAIGN_ID=

# ---- Worker ----
PORT=3001
# GLOBAL kill switch: true = engine logs decisions but NEVER mutates Google Ads.
# Per-campaign override lives in the campaigns.dry_run column.
DRY_RUN=true
