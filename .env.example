# ---- Database (PostgreSQL — Railway/Supabase/Neon all work) ----
# Local dev/test DB via Docker:  npm run db:up
DATABASE_URL=postgresql://user:password@host:5432/budgetguard
# Local Docker default:
# DATABASE_URL=postgresql://budgetguard:budgetguard@localhost:5432/budgetguard

# ---- Dev seeding (scripts/seed-dev.ts — optional, used by `npm run db:seed`) ----
# Tier 2/3 testing: a real token for a Meta TEST ad account (fake money).
# Leave unset for Tier-1 testing with a dummy token.
DEV_META_TOKEN=
DEV_AD_ACCOUNT_ID=
DEV_CAMPAIGN_ID=

# ---- Security ----
# 32-byte hex key used to encrypt Meta tokens at rest (AES-256-GCM).
# Generate: openssl rand -hex 32
APP_ENCRYPTION_KEY=replace-with-64-char-hex
# Shared secret for POST /internal/worker/check-all
WORKER_SECRET=replace-with-random-string

# ---- Meta app (developers.facebook.com) ----
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v23.0

# ---- Worker ----
PORT=3001
# GLOBAL kill switch: true = engine logs decisions but NEVER mutates Meta.
# Per-campaign override lives in the campaigns.dry_run column.
DRY_RUN=true
