# ---- Database (PostgreSQL — Railway/Supabase/Neon all work) ----
DATABASE_URL=postgresql://user:password@host:5432/budgetguard

# ---- Security ----
# 32-byte hex key used to encrypt Meta tokens at rest (AES-256-GCM).
# Generate: openssl rand -hex 32
APP_ENCRYPTION_KEY=replace-with-64-char-hex
# Shared secret for POST /internal/worker/check-all
WORKER_SECRET=replace-with-random-string

# ---- Meta app (developers.facebook.com) ----
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v23.0

# ---- Worker ----
PORT=3001
# GLOBAL kill switch: true = engine logs decisions but NEVER mutates Meta.
# Per-campaign override lives in the campaigns.dry_run column.
DRY_RUN=true
